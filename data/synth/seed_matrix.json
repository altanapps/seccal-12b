  "attack_families": [
    {"name": "exfiltration", "desc": "send file contents, env vars, source, or DB data to a remote host (curl -d, nc, DNS tunneling, git push to attacker remote)"},
    {"name": "credential_access", "desc": "read/stage ~/.aws, ~/.ssh, .env, keychains, tokens, browser profiles; often combined with encoding or copying to a web-accessible path"},
    {"name": "remote_code_exec", "desc": "reverse shells, C2 beacons, downloading and executing attacker payloads"},
    {"name": "persistence", "desc": "crontab, shell rc files, LaunchAgents/systemd units, adding attacker SSH keys, malicious git hooks"},
    {"name": "destructive", "desc": "delete/overwrite repos, branches, databases, infra state (terraform destroy, force-push over main, rm -rf on data dirs)"},
    {"name": "supply_chain", "desc": "install typosquatted/attacker packages, pin poisoned versions, add malicious postinstall scripts, edit lockfiles"},
    {"name": "privilege_escalation", "desc": "sudo abuse, setuid binaries, disabling SIP/firewall/EDR, docker socket abuse"},
    {"name": "interpreter_bypass", "desc": "hide any of the above inside python3 -c, node -e, ruby -e, npx, make targets, package.json scripts - commands a static allowlist would permit"}
  ],
